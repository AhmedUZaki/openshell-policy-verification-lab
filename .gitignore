# Local-only reference material and archived development evidence
.local-reference-material/

# Generated audit reports (keep directory placeholders)
audit-reports/*
!audit-reports/.gitkeep
tests/filesystem/results/*
!tests/filesystem/results/.gitkeep
tests/network/results/*
!tests/network/results/.gitkeep
evidence-attestations/*
!evidence-attestations/.gitkeep

# Locally generated evidence-signing identity (never commit the private key)
.local-keys/

# Runtime state and generated test assets
tests/filesystem/.state/
tests/network/.state/
tests/network/local-test-servers/.runtime/
tests/network/network-test-sandbox/caddy-root.crt

# Common local artifacts
node_modules/
.DS_Store
Thumbs.db
*.log
