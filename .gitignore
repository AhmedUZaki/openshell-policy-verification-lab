# Local-only reference material and archived development evidence
.local-reference-material/
tests/enforcement-audit/diagnostics/

# Generated audit reports (keep directory placeholders)
audit-reports/*
!audit-reports/.gitkeep
tests/enforcement-audit/filesystem/results/*
!tests/enforcement-audit/filesystem/results/.gitkeep
tests/enforcement-audit/network/results/*
!tests/enforcement-audit/network/results/.gitkeep
tests/tier-checks/results/*
!tests/tier-checks/results/.gitkeep
evidence-attestations/*
!evidence-attestations/.gitkeep

# Locally generated evidence-signing identity (never commit the private key)
.local-keys/

# Runtime state and generated test assets
tests/enforcement-audit/filesystem/.state/
tests/enforcement-audit/network/.state/
tests/enforcement-audit/network/local-test-servers/.runtime/
tests/enforcement-audit/network/network-test-sandbox/caddy-root.crt
tests/tier-checks/.state/

# Common local artifacts
node_modules/
.DS_Store
Thumbs.db
*.log

graphify-out/

# Results of earlier runs, moved here automatically by tests/enforcement-audit/archive-previous-results.mjs
archived-results/

# Temporary hand-over file written by the Windows launcher between its menu steps
.prepared-versions.tmp
