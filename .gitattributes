# Every text file is stored with LF and checked out with LF on every OS, whatever core.autocrlf says.
# This stops the "LF will be replaced by CRLF" warnings on Windows and keeps scripts and hashes identical everywhere.
* text=auto eol=lf

# Binary files are never converted.
*.png binary
*.pem -text

# Shell scripts run inside WSL (Linux) or natively on macOS/Linux: a CRLF
# line ending breaks them ("bash\r: command not found"), and Git on Windows
# converts to CRLF by default.
*.sh text eol=lf

# Batch files need CRLF on Windows (labels and goto can misbehave with LF only).
*.cmd text eol=crlf
*.bat text eol=crlf
